{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "definition-worker-delta.schema.json",
  "title": "CompCert4Lean definition worker delta",
  "description": "Compact judgment-and-exception report returned by a definition-translation worker. Deterministic packet, Git, command, hash, and default action bookkeeping is added later by the coordinator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delta_version",
    "completion_status",
    "worker_summary",
    "declaration_exceptions",
    "generated_surface_exceptions",
    "consulted_decision_ids",
    "additional_consulted_resources",
    "trust_concerns",
    "discrepancies",
    "requested_context",
    "proposed_next_action"
  ],
  "properties": {
    "delta_version": {
      "const": "1.0.0"
    },
    "completion_status": {
      "enum": [
        "candidate_ready",
        "needs_repair",
        "escalated"
      ]
    },
    "worker_summary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "declaration_exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declarationException"
      }
    },
    "generated_surface_exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generatedSurfaceException"
      }
    },
    "consulted_decision_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "additional_consulted_resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consultedResourceReference"
      }
    },
    "trust_concerns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trustConcern"
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/discrepancy"
      }
    },
    "requested_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextRequest"
      }
    },
    "proposed_next_action": {
      "$ref": "#/$defs/nextAction"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "relativeFilePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "leanIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fully_qualified_name",
        "declaration_kind",
        "type_descriptor"
      ],
      "properties": {
        "fully_qualified_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "declaration_kind": {
          "enum": [
            "abbrev",
            "class",
            "definition",
            "inductive",
            "instance",
            "opaque",
            "structure",
            "theorem"
          ]
        },
        "type_descriptor": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "declarationException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_declaration_id",
        "mapped_name",
        "canonical_provider",
        "outcome",
        "lean_identity",
        "notes",
        "api_outcome",
        "api_details"
      ],
      "properties": {
        "source_declaration_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mapped_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/relativeFilePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "translated",
                "reused_existing",
                "exact_statement_descriptor",
                "blocked",
                "not_applicable",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lean_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/leanIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "api_outcome": {
          "anyOf": [
            {
              "enum": [
                "preserved",
                "extended",
                "changed",
                "not_applicable",
                "blocked"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "api_details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "generatedSurfaceException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "outcome",
        "files",
        "details"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome": {
          "enum": [
            "unchanged",
            "updated",
            "not_applicable",
            "blocked",
            "failed"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativeFilePath"
          },
          "uniqueItems": true
        },
        "details": {
          "type": "string"
        }
      }
    },
    "consultedResourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier",
        "purpose"
      ],
      "properties": {
        "kind": {
          "enum": [
            "packet",
            "bundle",
            "prompt",
            "schema",
            "source",
            "target",
            "decision",
            "other"
          ]
        },
        "identifier": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "trustConcern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lean_name",
        "category",
        "outcome",
        "details"
      ],
      "properties": {
        "lean_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "enum": [
            "assumption",
            "evaluation",
            "foreign_interface",
            "safety",
            "termination",
            "other"
          ]
        },
        "outcome": {
          "enum": [
            "requires_review",
            "blocked"
          ]
        },
        "details": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "discrepancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expected",
        "observed",
        "impact",
        "blocking"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expected": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observed": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "impact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "contextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request",
        "reason",
        "blocking"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "request": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "owner",
        "rationale"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
